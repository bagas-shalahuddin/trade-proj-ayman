# copy to .env and fill in. NEVER commit .env.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# the same string you type into the Pine input "Webhook secret"
WEBHOOK_SECRET=
# broker's gold symbol, e.g. XAUUSD or XAUUSD.raw
SYMBOL=XAUUSD
# fraction of initial balance risked per trade; 0.0075 = $37.50 on $5k
RISK_FRAC=0.0075
