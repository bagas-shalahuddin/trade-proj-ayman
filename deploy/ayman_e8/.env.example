# Copy to .env and fill in.  NEVER commit .env -- it holds your broker password.
#   cp .env.example .env     (Linux)      Copy-Item .env.example .env   (Windows)

# ---- MT5 account -----------------------------------------------------------
# The prop-firm account, not your personal one. The MT5 terminal must already be
# installed, logged in, and RUNNING on the same machine; these only re-authenticate.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ---- webhook ---------------------------------------------------------------
# Long random string. Paste the SAME value into the Pine input "Webhook secret".
# Anyone who learns your URL can trade the account without it.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# ---- server ----------------------------------------------------------------
# TradingView accepts ONLY ports 80 and 443; anything else is rejected outright.
# Leave these unless you are putting a reverse proxy in front. Binding 80 on Windows
# needs an elevated shell.
HOST=0.0.0.0
PORT=80

# ---- instrument ------------------------------------------------------------
# Exactly as the broker names it. Check in MT5's Market Watch: some brokers use
# XAUUSD.raw, XAUUSD.m, GOLD. Wrong name = every order rejected.
SYMBOL=XAUUSD

# ---- which firm's rules to enforce -----------------------------------------
# Keys come from strategies/_plans.py. The engine refuses risk that would breach
# whichever is set here, so it must match the account you are actually trading.
#   e8_pro_5k              $5k, 8% target / 8% static DD / 2.5% daily / $100 per day cap
#   fundednext_trial_100k  $100k trial, 5% / 10% static / 5% daily, 14-DAY LIMIT
#   fundingpips_50k, fundingpips_100k, the5ers_a_10k, the5ers_b_10k
PLAN=e8_pro_5k

# ---- risk per trade --------------------------------------------------------
# Fraction of the plan's INITIAL balance risked per trade; the engine cuts it
# further whenever a limit is near. Measured on Ayman M30 + relvol, 5 years:
#
#   e8_pro_5k              0.0075  -> P(pass) 97%, honest floor 79%, 48 days
#                          0.005   -> 98%, floor 72%, 76 days, bust 0.4%
#   fundednext_trial_100k  0.03    -> P(pass) 73%  <- a 14-day deadline needs SIZE
#                          0.0075  -> 20%, because 80% of attempts TIME OUT
#
# Raising this past ~2% trades edge for speed: at 3% the zero-edge control already
# scores 55% of the 73%. The server logs a warning if a deadline plan is sized small.
RISK_FRAC=0.0075
